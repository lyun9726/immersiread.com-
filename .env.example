# ElevenLabs API (for voice cloning and TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Database
DATABASE_URL=

# Auth
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=https://omniread.app

# Google OAuth (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Other API keys
OPENAI_API_KEY=

# Google Translate API (for instant translation)
GOOGLE_TRANSLATE_API_KEY=

# Google Cloud TTS API (for server-side text-to-speech)
GOOGLE_CLOUD_TTS_API_KEY=

# ============================================
# Analytics & SEO Verification
# ============================================

# Google Analytics 4 (https://analytics.google.com/)
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Microsoft Clarity (https://clarity.microsoft.com/)
# Project ID from Clarity dashboard
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Google Search Console Verification
# Get from: Search Console → Settings → Ownership verification → HTML tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmasters Verification
# Get from: Bing Webmaster Tools → Configure My Site → Verify Ownership
NEXT_PUBLIC_BING_SITE_VERIFICATION=
